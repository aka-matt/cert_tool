{
  "id": "FIPS_140_3_ASSESSMENT",
  "name": "FIPS 140-3 Compatibility Assessment",
  "targetStandard": "FIPS_140_3",
  "schemaVersion": "2026-01-01",
  "allowedAlgorithms": ["RSA", "EC", "EdDSA"],
  "disallowedAlgorithms": ["MD2", "MD5", "SHA1", "RIPEMD160"],
  "minimumKeySizes": {
    "RSA": 3072,
    "EC": 256,
    "DSA": 3072
  },
  "allowedCurves": ["P-256", "P-384", "P-521", "Ed25519", "Ed448"],
  "sha1Policy": "DISALLOW",
  "expirationPolicy": "FAIL",
  "unknownAlgorithmPolicy": "NOT_ASSESSABLE",
  "jksPrivateKeyPolicy": "FAIL",
  "requiredRuntimeProvider": "BCFIPS",
  "approvedOnlyRequired": true,
  "references": [
    "https://csrc.nist.gov/projects/fips-140-3",
    "https://csrc.nist.gov/publications/detail/fips/140/3/final"
  ]
}